# Set to production on the hosted API. Production refuses SQLite, the example
# JWT secret, missing R2 configuration, and localhost-only CORS origins.
APP_ENV=development

# Database
DATABASE_URL=postgresql://signbridge:signbridge@localhost:5432/signbridge
# Optional: use Neon’s direct endpoint for Alembic; the API uses DATABASE_URL.
MIGRATION_DATABASE_URL=

# Security
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# API
API_V1_PREFIX=/api/v1
PROJECT_NAME=SignBridge Data Collection Tool
VERSION=1.0.0

# Storage
STORAGE_PATH=./storage/videos
MAX_UPLOAD_SIZE=104857600

# Cloudflare R2 S3-compatible storage. Video uploads require these values.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_PREFIX=signbridge
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# For R2, endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
